# SIGES - Variables de entorno (plantilla de ejemplo)
# Copia este archivo como `.env` y rellena los valores reales:
#   cp .env.example .env
# IMPORTANTE: `.env` contiene secretos y NO debe subirse a git.

# Credenciales de la base de datos PostgreSQL
DB_USERNAME=inventario
DB_PASSWORD=cambiar_esto

# Credenciales SMTP de Gmail (contraseña de aplicación).
# Cómo obtenerla: Cuenta de Google -> Seguridad -> Verificación en 2 pasos
# -> Contraseñas de aplicaciones. Formato: xxxx xxxx xxxx xxxx
MAIL_USERNAME=tu.correo@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Secreto JWT: firma de tokens de sesión. Generar una clave fuerte:
#   openssl rand -base64 48
# Debe mantenerse en secreto (nunca subir a git) y ser distinta por entorno.
JWT_SECRET=cambiar_esto
