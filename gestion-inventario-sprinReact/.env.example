# Copiar este archivo a `.env` y ajustar los valores antes de desplegar.

# Dominio DuckDNS apuntando a la IP pública de la instancia Oracle Free.
# Caddy obtiene y renueva el certificado TLS de Let's Encrypt automáticamente.
# Para probar en local, dejar como "localhost" (sirve por HTTP sin certificado).
DOMAIN=localhost
