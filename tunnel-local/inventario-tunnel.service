[Unit]
Description=Tunel HTTPS de Cloudflare para el inventario (quick tunnel)
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/gestioninventario/siges/gestion-inventario-sprinReact/tunnel-local

# Levanta el tunel y notifica la URL. notify-url.sh verifica que la URL
# responda de verdad y, si Cloudflare invalido el quick tunnel anterior, lo
# reinicia hasta conseguir una viva antes de avisar.
ExecStart=/home/gestioninventario/siges/gestion-inventario-sprinReact/tunnel-local/boot-notify.sh
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
