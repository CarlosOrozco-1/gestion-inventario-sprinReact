# Los scripts de shell deben viajar con LF. Con CRLF fallan en Linux con
# errores tipo "\r: command not found" al ejecutar deploy-local.sh y los
# scripts de respaldo. Se fija aqui para que no dependa del core.autocrlf
# de cada maquina.
*.sh text eol=lf

# Los Dockerfiles se interpretan linea por linea: CRLF tambien los rompe.
Dockerfile text eol=lf
*/Dockerfile text eol=lf

# Las unidades systemd del tunel. Un ExecStart con CRLF deja el caracter de
# retorno pegado a la ruta y systemd no encuentra el binario.
*.service text eol=lf
*.timer text eol=lf
