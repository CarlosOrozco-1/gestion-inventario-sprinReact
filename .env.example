# SIGES - Variables de entorno (plantilla de ejemplo)
# Copia este archivo como `.env` y rellena los valores reales:
#   cp .env.example .env
# IMPORTANTE: `.env` contiene secretos y NO debe subirse a git.
#
# NOTA sobre la IP: el servidor de la LAN entrega su direccion por DHCP, asi
# que la IP NO esta escrita en el codigo (scripts, documentacion ni compose).
# Vive aqui, en estas tres variables, y es lo unico que hay que editar cuando
# el router cambie la direccion. Para entrar por SSH usa el alias "siges"
# definido en ~/.ssh/config, que tampoco lleva la IP.
SERVER_IP=cambia_esto
APP_PUERTO=8081
API_PUERTO=8080

# Credenciales de la base de datos PostgreSQL
DB_USERNAME=inventario
DB_PASSWORD=cambiar_esto

# Credenciales SMTP de Gmail (contraseña de aplicación).
# Cómo obtenerla: Cuenta de Google -> Seguridad -> Verificación en 2 pasos
# -> Contraseñas de aplicaciones. Formato: xxxx xxxx xxxx xxxx
MAIL_USERNAME=tu.correo@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Secreto JWT: firma de tokens de sesión. Generar una clave fuerte:
#   openssl rand -hex 48
# OBLIGATORIO: 64 bytes o mas. La firma usa HS512 y con menos bytes el
# backend responde 500 en /api/auth/login (WeakKeyException). Este valor de
# ejemplo es un placeholder y NO sirve para arrancar.
# Debe mantenerse en secreto (nunca subir a git) y ser distinta por entorno.
JWT_SECRET=cambiar_esto

# Orígenes CORS permitidos, separados por comas (admiten comodines). El
# navegador envía "Origin" incluso en peticiones same-origin, así que un
# origen ausente de esta lista produce 403 en /api/auth/login.
#   - entorno local por IP de red:  http://192.168.200.*:*
#   - túnel Cloudflare Quick:       https://*.trycloudflare.com
# Se usa el comodín y NO ${SERVER_IP}: el comodín ya cubre cualquier IP de la
# LAN, así que un cambio de DHCP no rompe el CORS y no depende de que Compose
# interpole la variable.
CORS_ALLOWED_ORIGINS=http://localhost:*,http://192.168.200.*:*,https://*.trycloudflare.com,https://localhost:*

# Usuario administrador inicial (creado/sincronizado por el DataSeeder).
# El sistema ya NO crea un admin hardcodeado: si estas variables se omiten, no
# se genera ningún administrador al arrancar. El .env es la fuente de verdad:
# cada arranque que cambie ADMIN_PASSWORD actualiza la contraseña del admin.
ADMIN_EMAIL=admin@inventario.com
ADMIN_PASSWORD=cambiar_admin_password
